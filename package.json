{
  "name": "daymark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --config wrangler.local.jsonc --port 5184",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run check:migrations && npm test && npm run build && npm run test:browser && npm run check:deploy && npm audit --audit-level=high",
    "check:migrations": "node scripts/check-migrations.ts",
    "check:deploy": "node scripts/check-config.mjs && wrangler deploy --dry-run --outdir .worker-dry-run",
    "db:local": "wrangler d1 migrations apply daymark --local --config wrangler.local.jsonc",
    "deploy": "npm run verify && wrangler d1 migrations apply daymark --remote && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "idb": "8.0.4",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/workers-types": "5.20261024.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.0.0",
    "miniflare": "5.20261019.2-beta",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
