{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daymark",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "daymark.lasers.app", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daymark",
      "database_id": "0602f183-577b-43a4-8bb3-a31754a57511",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://daymark.lasers.app",
    "ACCESS_REQUIRED": "false",
    "ACCESS_ISSUER": "https://j256.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "8ee74f3ff45a4287d3cae08b0cb195c2f94fcbc559527f99cae213a551c7cf10",
    "ADMIN_ACCESS_AUDIENCE": "16d244a8bc2118401f1e782cff0eee857be960cb8ed26eadbbe390e6c435cc91"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
